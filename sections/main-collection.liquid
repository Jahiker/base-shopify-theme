<div class="main-collection">
  <h1>{{ collection.title }}</h1>
  <p>{{ collection.description }}</p>

  <ul>
    {% for product in collection.products %}
      <li>
        <a href="{{ product.url }}">
          {{ product.title }}
        </a>
      </li>
    {% endfor %}
  </ul>
</div>

{% schema %}
{
  "name": "Main Collection",
  "tag": "section",
  "class": "main-collection__section",
  "settings": []
}
{% endschema %}
