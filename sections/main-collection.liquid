<h1>{{ collection.title }}</h1>
<p>{{ collection.description }}</p>

<ul>
  {% for product in collection.products %}
    <li>
      <a href="{{ product.url }}">
        {{ product.title }}
      </a>
    </li>
  {% endfor %}
</ul>

{% schema %}
  {
    "name": "Main Collection",
    "settings": []
  }
{% endschema %}
