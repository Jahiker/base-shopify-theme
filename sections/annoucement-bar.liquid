{% comment %} referenced as 'AB' in commit messages {% endcomment %}

{% liquid
  assign text_color_check = section.settings.overwrite_text_colour
  assign text_color = section.settings.text_colour
  assign background_colour = section.settings.background
%}

{% style %}
  #shopify-section-{{ section.id }} {
      --background-color: {{ background_colour }};
      --text-color: {{ text_color }};
  }
{% endstyle %}

<div class="w-full">
  <swiper-slider class="announcement-bar-container swiper bg-(--background-color)">
    <div
      class="announcement-bar-wrapper swiper-wrapper py-[10px]! md:py-[7px]"
    >
      {% for item in section.blocks %}
        {% assign announcement = item.settings %}
        <div
          class="announcement-bar-announcement swiper-slide text-center w-full"
        >
          <p
            class="w-full text-center {% if text_color_check %}text-(--text-color){% else %}text-white{% endif %}"
          >
            {{ announcement.text }}
          </p>
        </div>
      {% endfor %}
    </div>
    <script type="application/json">
      {
        "slidesPerView": 1,
        "grabCursor": true,
        "spaceBetween": 44,
        "loop": true,
        "speed": 2000,
        "autoplay": {
          "delay": 2000,
          "disableOnInteraction": false
        }
      }
    </script>
  </swiper-slider>
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "max_blocks": 12,
  "class": "announcement-bar",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background colour",
      "default": "#90CAFF"
    },
    {
      "type": "checkbox",
      "id": "overwrite_text_colour",
      "label": "Overwrite text colour?",
      "default": false,
      "info": "If enabled, the colour situated in the field below will be used - the default here is white."
    },
    {
      "type": "color",
      "id": "text_colour",
      "label": "Text colour",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Welcome to our store",
          "label": "Announcement Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
